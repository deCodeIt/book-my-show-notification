# Shared access token for the web UI and API.
# Leave empty to disable auth — only do that on localhost / a trusted LAN.
APP_TOKEN=change-me

# Pushbullet access token. Optional: recipients are normally added in the UI.
# Setting it here adds it as an extra recipient (deduplicated by token).
PUSHBULLET_TOKEN=

# Default poll interval (seconds) used when creating a watch.
BMS_DEFAULT_INTERVAL=60

# Host port published by docker compose (default 7654).
PORT=7654

# Host directory backing the bms_data volume (internal disk). Create it first:
#   mkdir -p ~/docker/drive/bms
# Leave unset to use ${HOME}/docker/drive/bms.
# BMS_DATA_DIR=/Users/you/docker/drive/bms
